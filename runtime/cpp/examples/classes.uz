# Sinflar va meros (single inheritance) — native runtime to'liq qo'llaydi.

sinf Hayvon:
    funksiya __init__(o'zi, ism):
        o'zi.ism = ism

    funksiya ovoz(o'zi):
        qaytarsin "..."

    funksiya tanishtir(o'zi):
        yoz(o'zi.ism, "deydi:", o'zi.ovoz())


sinf It(Hayvon):
    funksiya ovoz(o'zi):
        qaytarsin "Vov-vov!"


sinf Mushuk(Hayvon):
    funksiya ovoz(o'zi):
        qaytarsin "Miyov!"


hayvonlar = [It("Bobik"), Mushuk("Misha"), Hayvon("Begona")]
uchun h ichida hayvonlar:
    h.tanishtir()
